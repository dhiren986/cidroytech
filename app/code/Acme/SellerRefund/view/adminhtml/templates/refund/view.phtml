                    <td><span class="acme-status-pill <?= $block->escapeHtmlAttr($block->statusPillClass($event->getEventStatus())) ?>"><?= $block->escapeHtml($event->getEventStatus()) ?></span></td>
                    <td><?= $block->escapeHtml($event->getStatusFrom()) ?></td>
                    <td><?= $block->escapeHtml($event->getStatusTo()) ?></td>
                    <td><?= $block->escapeHtml($event->getApiCode()) ?></td>
