                <tr><th><?= $block->escapeHtml(__('Cash Refund Status')) ?></th><td><span class="acme-status-pill <?= $block->escapeHtmlAttr($block->statusPillClass($refund->getCashRefundStatus())) ?>"><?= $block->escapeHtml($refund->getCashRefundStatus()) ?></span></td></tr>
